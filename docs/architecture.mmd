%% docs/architecture.mmd — this repo's own internal structure.
%% Hand-authored, not generated — this is a flat grab-bag of independent
%% Python tools grouped by domain folder, not a single coupled system, so
%% there is no crawl-and-render pipeline the way fleet-config's system-map
%% works. Update this diagram in the same PR as any material structural
%% change (a new domain folder, a shared helper introduced/moved, a script
%% relocated) — same anti-staleness contract as a `.fleet.toml` `description`
%% field. See fleet-config's global-CLAUDE.md "Every repo carries a
%% `.fleet.toml`" section for the general convention.

flowchart TB
  ENV[".env / .env.sample\nroot secrets + shared config (API keys, folder paths)"]
  REQ["requirements.txt\nshared Python deps, source-commented per script"]
  VENVMGR["tools/system/venv_manager.py\ncreates/monitors the shared .venv"]
  REQ --> VENVMGR
  NOWIN["no_window.py\nrepo-root shared NO_WINDOW creationflags constant —\nevery subprocess spawn in the domain folders imports it"]
  POOLED["tools/system/_lib/pooled_http.py\nvendored keep-alive session: every outbound requests call in the\ndomain folders goes through pooled_request (the must_use ratchet holds it)"]
  RTFILES["tools/system/_lib/runtime_files.py\nshared writers: refuse paths inside the checkout,\nplus runtime_data_dir() for logs and scratch output"]
  NOTIFIER["tools/system/_lib/notifier.py\nFleetNotifier: Telegram through the fleet notify_send.py,\nshared by parking and the Photos weekly job"]
  STEALTH["browser_stealth.py\nrepo-root shared human-looking Chrome launch for Playwright\n(stealth kwargs + init script + busy-profile backoff)"]

  subgraph domains["Domain folders — mostly independent scripts, each usually paired\nwith a .bat launcher, a per-script .md doc, and/or a JSON config"]
    AUDIO["tools/audio/\naudio_extractor_core/gui · audio_normalize · audio_trim ·\nconvert_ogg_mp3 · transcript_collate"]
    IMAGE["tools/image/\nillustrations_formatter(_gui) · image_resizer ·\ncarrousel_pdf_to_jpg · pdf_to_jpg/ · screenshot · imgur_check_rate ·\nphotos_archive (CLI) + photos_archive_config/_metadata/_duplicates\n(config+logging / date extraction+scan / duplicate analysis)"]
    VIDEO["tools/video/\nscreen_recorder · video_download · video_reencoder ·\nvideo_trim/concatenator · _ffmpeg_utils.py (shared ffmpeg/ffprobe helpers) ·\ngpu_recovery (reads powershell/nvidia-smi/pnputil via _lib/console_output)"]
    TEXT["tools/text/\nconvert_pdf_to_txt · clean_sensitive_data"]
    TESTS["tests/\none folder per domain, mirroring the tool path it covers\n(tests/system/wifi/ tests tools/system/wifi/)"]
    EXCEL["tools/excel/\naccounting_stripe/"]
    HTML["tools/html/\ncountdown_timer.html"]
    SMARTLIFE["tools/smart_life/\ndevice automation (despacho_switch.bat, devices.sample.json)"]
    PARKING["tools/parking/\npoller: 15-min heartbeat books a free parking slot (deterministic, no LLM) ·\napi · auth · planner · booking · poller · report · login ·\nburst + burst_worker: Thursday 16:00 one console worker per day, observer Chrome windows · own tools/parking/.env · dry_run on by default ·\nscheduled by the app-launcher Jobs entry parking-poll"]
    SYSTEM["tools/system/\nkeycaster · textexpander/ · apple/ ·\nmarkdown_preview · mouse_mover ·\noutlook_web_mail (CLI) over outlook_web.py (reusable Playwright\nOutlook-on-the-web library: drafts, optional send) ·\nwifi/ (_netsh.py = shared netsh runner: byte capture + explicit decoding,\nused by wifi_connect.py + wifi_passwords.py + wifi_bat_generator.py) ·\nsnap/ (snap_core.py = GUI-free naming, crop maths and config; snap_tool.py = RegisterHotKey thread,
Tk overlay, tray; saves via _lib/runtime_files) ·
quickdeck/ (quickdeck.py = window + event loop; quickdeck_config_gui.py =\nsettings editor; quickdeck_render.py = GUI-free PIL button images;\nquickdeck_actions.py = GUI-free action executors) ·\nfoldersearcher/ (retired; code kept for task-os and life-os; foldersearcher.py = tray UI;\nfoldersearcher_core.py = GUI-free logic;\nfoldersearcher_cli.py = headless scan, run by hand) ·\n_lib/ = the repo's shared-helper package:\nsingle_instance.py (Windows-mutex single-instance guard, used by\nmouse_mover.py + markdown_preview.py + foldersearcher.py) and console_output.py\n(run_console: native-console-tool byte capture + ordered explicit decode, used by\nwifi/_netsh.py + tools/video/gpu_recovery.py)"]
  end
  ENV --> domains
  VENVMGR -.->|shared runtime for| domains
  NOWIN -.->|imported by| domains
  POOLED -.->|imported by| domains
