{
  "default_subnet": "192.168.0.0/24",
  "default_output": "network_scan.json",
  "scan_timeout": 2,
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(message)s"
  },
  "output_format": {
    "include_metadata": true,
    "pretty_print": true,
    "ensure_ascii": false
  },
  "arp_scan": {
    "timeout": 2,
    "retry_count": 2,
    "verbose_output": true
  }
}