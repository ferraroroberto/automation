# ignore temporary and virtual environment
.venv

# configuration files with user sensitive information
.env
google/config.json
google/config_gmail_drive.json
google/config_weekly_photo.json
google/client_secret.json
google/token*.json
system/wifi/wifi_connect.xml
system/wifi/wifi_export.json
system/quickdeck/quickdeck.json
linkedin/open_profiles/linkedin_open.json
linkedin/genially_profiles_extractor/config.json
smart_life/devices.json
smart_life/snapshot.json
smart_life/cloud.json
tinytuya.json

# application settings
text_expander_config.json

# logs
*.log

# local variables
notion/articles_sync/notion_articles_sync_last_time.txt

# cache
__pycache__

# workspaces
*.code-workspace

# temporary files
system/foldersearcher/folder_structure.txt
notion/build_newsletter.html
system/textexpander/text_expander_config.json
notion/articles_sync/notion_articles_sync_last_time.txt
tmp*
streamlit_demo/data/*

# TLS certificates (e.g. from tailscale cert — never commit private keys)
certificates/

# claude
.claude/settings.local.json
.claude/scheduled_tasks.lock

# notion articles sync
notion/articles_sync/notion_articles_sync_last_time.txt

# launcher Apps tab — user-specific list of discovered Streamlit launchers
launcher/apps_config.json

# Launcher scratch (ephemeral images/logs written by the tray launcher)
.launcher-tmp/

# PyInstaller build output (reproducible from source + build_minimal.bat)
image/pdf_to_jpg/dist/