# Environment Variables Sample File
# Copy this file to .env and fill in your actual values

# Notion API Configuration
NOTION_API_TOKEN=your_notion_api_token_here
NOTION_TOKEN_V2=your_notion_token_v2_here
NOTION_WORKSPACE_URL=https://www.notion.so/your-workspace/

# Imgur API Configuration
IMGUR_CLIENT_ID=your_imgur_client_id_here
IMGUR_ACCESS_TOKEN=your_imgur_access_token_here

# SerpAPI Configuration
SERPAPI_KEY=your_serpapi_key_here

# Tuya / Smart Life Configuration (for tinytuya wizard)
TUYA_API_KEY=your_tuya_access_id_here
TUYA_API_SECRET=your_tuya_access_secret_here
TUYA_API_REGION=eu