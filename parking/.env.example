# Copy to .env (gitignored) and fill in. Never commit .env.
PARKING_URL=<site booking page URL>
PARKING_API_URL=<GraphQL endpoint URL>
PARKING_USER=<site login user, informational>
PARKING_LICENSE_PLATE=<plate to book with>
# Written by `python -m parking.login` (never type or print it):
PARKING_TOKEN=
# Telegram goes through the fleet notifier; bot token + chat routing live in fleet-config.
NOTIFY_PYTHON=E:/automation/fleet-config/.venv/Scripts/python.exe
NOTIFY_SCRIPT=E:/automation/fleet-config/hooks/notify_send.py
NOTIFY_CATEGORY=attention
# Optional: send to one specific chat id instead of the category's chat.
# NOTIFY_CHAT=
# Optional: keep the login browser profile outside the repo checkout.
# PARKING_PROFILE_DIR=
